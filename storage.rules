rules_version = '2';

// Nearby — Cloud Storage security rules.
//
// The only user-uploaded content in the MVP is shop imagery, which belongs to
// exactly one business and is written by exactly one owner.
service firebase.storage {
  match /b/{bucket}/o {

    match /businesses/{businessId}/{fileName} {
      // Shop photos appear on public listings, so any signed-in user reads them.
      allow read: if request.auth != null;

      allow write: if request.auth != null
        // Ownership is asserted by the Firestore listing, which is the single
        // source of truth for who owns what.
        && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerId
             == request.auth.uid
        // Images only, capped at 5MB — enough for a photo, small enough that a
        // single upload cannot exhaust the bucket.
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerId
             == request.auth.uid;
    }

    // Nothing else is writable.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
